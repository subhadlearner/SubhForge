{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "agent": {
    "ask": {
      "model": "openai/gpt-5.6-luna"
    },
    "code": {
      "model": "deepseek/deepseek-flash"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol"
    },
    "debug": {
      "model": "deepseek/deepseek-flash"
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git diff --raw*": "allow",
      "git hash-object --no-filters *": "allow",
      "git hash-object --stdin*": "allow",
      "dotnet build*": "allow",
      "dotnet test*": "allow",
      "dotnet format --verify-no-changes*": "allow",
      "pytest*": "allow",
      "ruff check*": "allow",
      "npm test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "Remove-Item *": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    },
    "edit": "ask",
    "task": {
      "*": "deny",
      "adversary": "allow",
      "adversary-opus": "ask",
      "code-reviewer": "allow",
      "pre-reviewer": "allow",
      "adversary-sonnet": "ask",
      "planning-worker": "allow",
      "adversary-flex": "allow",
      "smoke-executor": "allow"
    },
    "skill": "ask",
    "websearch": "ask",
    "webfetch": "ask",
    "todoread": "allow",
    "todowrite": "ask"
  },
  "experimental": {
    "task_model_selection": true
  }
}
